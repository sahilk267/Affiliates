APP_NAME=Affiliates
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# For MySQL deployments, replace the above with DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=affiliates
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_EMAIL=admin@example.com
ADMIN_NAME="Affiliates Admin"
# Required outside local/testing. Never commit a real password.
ADMIN_PASSWORD=

# Required for POST /api/affiliate/conversion and POST /api/points/credit.
AFFILIATE_API_KEY=
AFFILIATE_API_SECRET=

# Comparison preview safety switches. Rewards, vouchers, and gifts remain disabled by default.
COMPARISON_PREVIEW_ENABLED=true
COMPARISON_REWARDS_ENABLED=false
COMPARISON_VOUCHERS_ENABLED=false
COMPARISON_GIFTS_ENABLED=false

# Only set source-specific credentials after written partner approval and approved staging setup.
# AMAZON_CREATORS_API_*=
# FLIPKART_AFFILIATE_*=
# AFFILIATE_NETWORK_*
