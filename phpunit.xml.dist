<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php" colors="true">
    <php>
        <env name="APP_ENV" value="testing" force="true" />
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true" />
        <env name="APP_DEBUG" value="true" force="true" />
        <env name="DB_CONNECTION" value="sqlite" force="true" />
        <env name="DB_DATABASE" value="database/testing.sqlite" force="true" />
        <env name="CACHE_DRIVER" value="array" force="true" />
        <env name="SESSION_DRIVER" value="array" force="true" />
        <env name="QUEUE_CONNECTION" value="sync" force="true" />
        <env name="MAIL_MAILER" value="array" force="true" />
        <env name="AFFILIATE_API_KEY" value="test-api-key" force="true" />
        <env name="AFFILIATE_API_SECRET" value="test-api-secret" force="true" />
    </php>
    <testsuites>
        <testsuite name="Unit">
            <directory>./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>./tests/Feature</directory>
        </testsuite>
    </testsuites>
</phpunit>
